# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Ваш Telegram ID — доступ к /stats, /grant, /refund, /payments (узнать: @userinfobot)
ADMIN_ID=123456789
# Доп. администраторы через запятую (кроме ADMIN_ID), можно оставить пустым
ADMIN_IDS=

# --- необязательные параметры (указаны значения по умолчанию) ---
# Путь к файлу SQLite
DB_PATH=data/bot.db
# Часовой пояс для времени в уведомлениях
TIMEZONE=Europe/Moscow
# Пробный период, дней
TRIAL_DAYS=7
# Цены тарифов в Telegram Stars (XTR): 30 / 90 / 365 дней
PRICE_30D=200
PRICE_90D=500
PRICE_365D=1600
# Авто-удаление старых записей и файлов, дней. 0 = хранить бессрочно (по умолчанию)
RETENTION_DAYS=0
# Как часто повторять напоминание об истёкшей подписке, часов
REMINDER_INTERVAL_HOURS=24

# Прокси, если api.telegram.org недоступен (оставьте пустым, если не нужен).
# Примеры: http://логин:пароль@1.2.3.4:8080   или   socks5://127.0.0.1:1080
PROXY_URL=

# Сохранять текст входящих сообщений и показывать его в уведомлении об удалении (1 — да, 0 — нет).
# Текст показывается в уведомлении об удалении. При 0 — сообщается только факт удаления.
STORE_MESSAGE_TEXT=1

# Скачивать медиафайлы (фото/видео/документы) на диск сразу при получении (1/0)
STORE_MEDIA=1
# Папка для сохранённых медиафайлов
MEDIA_DIR=data/media
